# Maintainer DX: copy to docker-compose.yml (gitignored).
# Sibling repos under /var/www/concept + COMPOSER=composer-dev.json (path repos / symlinks).
#
#   cp docker-compose.dev.yml.example docker-compose.yml
#   cp composer-dev.json.example composer-dev.json
#   docker compose up -d --build
#   docker compose exec php composer install
services:
  php:
    build: .
    container_name: concept_apps_php
    restart: unless-stopped
    user: "${UID:-1000}:${GID:-1000}"
    working_dir: /var/www/html
    volumes:
      - .:/var/www/html
      - ../concept-core-2:/var/www/concept-core-2
      - ../concept-stack:/var/www/concept-stack
      - ../concept-extensions:/var/www/concept-extensions
      - ../concept-bricks:/var/www/concept-bricks
      - ./docker/php/error-reporting.ini:/usr/local/etc/php/conf.d/error-reporting.ini
    environment:
      - COMPOSER=composer-dev.json
    depends_on:
      - db

  db:
    image: mysql:8.4
    command: --mysql-native-password=ON
    container_name: concept_apps_db
    restart: unless-stopped
    environment:
      MYSQL_DATABASE: concept_apps
      MYSQL_ROOT_PASSWORD: root
    ports:
      - "3306:3306"
