{
    "name": "php-concept/app-web",
    "description": "Concept 2 \u2014 web assembly (session + CSRF + Twig + database; browser app scaffold)",
    "type": "project",
    "license": "MIT",
    "repositories": [
        {
            "type": "path",
            "url": "/var/www/concept-core-2",
            "options": {
                "symlink": true,
                "versions": {
                    "php-concept/core-2": "1.0.0"
                }
            }
        },
        {
            "type": "path",
            "url": "/var/www/concept-stack",
            "options": {
                "symlink": true,
                "versions": {
                    "php-concept/stack": "2.0.0"
                }
            }
        },
        {
            "type": "path",
            "url": "/var/www/concept-extensions/packages/*",
            "options": {
                "symlink": true,
                "versions": {
                    "php-concept/extension-casting-valinor": "3.0.0",
                    "php-concept/extension-components": "3.0.0",
                    "php-concept/extension-config": "3.0.0",
                    "php-concept/extension-console-symfony": "3.0.0",
                    "php-concept/extension-csrf": "3.0.0",
                    "php-concept/extension-data-masker": "3.0.0",
                    "php-concept/extension-database-eloquent": "3.0.0",
                    "php-concept/extension-error-handler-whoops": "3.0.0",
                    "php-concept/extension-event": "3.0.0",
                    "php-concept/extension-form-request": "3.0.0",
                    "php-concept/extension-http": "3.0.0",
                    "php-concept/extension-json": "3.0.0",
                    "php-concept/extension-logger-monolog": "3.0.0",
                    "php-concept/extension-path-manager": "3.0.0",
                    "php-concept/extension-session-symfony": "3.0.0",
                    "php-concept/extension-support": "3.0.0",
                    "php-concept/extension-telemetry": "3.0.0",
                    "php-concept/extension-validation-rakit": "3.0.0",
                    "php-concept/extension-view": "3.0.0",
                    "php-concept/extension-view-plates": "3.0.0",
                    "php-concept/extension-view-twig": "3.0.0"
                }
            }
        },
        {
            "type": "path",
            "url": "/var/www/concept-bricks/packages/*",
            "options": {
                "symlink": true,
                "versions": {
                    "php-concept/brick-casting-valinor": "3.0.0",
                    "php-concept/brick-components": "3.0.0",
                    "php-concept/brick-console-symfony": "3.0.0",
                    "php-concept/brick-database-eloquent": "3.0.0",
                    "php-concept/brick-data-masker": "3.0.0",
                    "php-concept/brick-error-handler-whoops": "3.0.0",
                    "php-concept/brick-event": "3.0.0",
                    "php-concept/brick-http": "3.0.0",
                    "php-concept/brick-logger-monolog": "3.0.0",
                    "php-concept/brick-session-symfony": "3.0.0",
                    "php-concept/brick-telemetry": "3.0.0",
                    "php-concept/brick-validation-rakit": "3.0.0",
                    "php-concept/brick-view": "3.0.0",
                    "php-concept/brick-view-twig": "3.0.0",
                    "php-concept/brick-view-plates": "3.0.0"
                }
            }
        },
        {
            "type": "path",
            "url": "/var/www/concept-components/packages/*",
            "options": {
                "symlink": true,
                "versions": {
                    "php-concept/component-auth-api-token": "1.0.0"
                }
            }
        }
    ],
    "require": {
        "php": "^8.4",
        "php-concept/brick-casting-valinor": "^3.0",
        "php-concept/brick-console-symfony": "^3.0",
        "php-concept/brick-data-masker": "^3.0",
        "php-concept/brick-database-eloquent": "^3.0",
        "php-concept/brick-error-handler-whoops": "^3.0",
        "php-concept/brick-http": "^3.0",
        "php-concept/brick-logger-monolog": "^3.0",
        "php-concept/brick-session-symfony": "^3.0",
        "php-concept/brick-validation-rakit": "^3.0",
        "php-concept/brick-view": "^3.0",
        "php-concept/brick-view-twig": "^3.0",
        "php-concept/core-2": "^1.0",
        "php-concept/extension-config": "^3.0",
        "php-concept/extension-path-manager": "^3.0",
        "php-concept/stack": "^2.0",
        "twbs/bootstrap": "^5.3",
        "twbs/bootstrap-icons": "^1.13"
    },
    "autoload": {
        "psr-4": {
            "Concept\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "phpstan/phpstan": "^2.1"
    },
    "scripts": {
        "post-install-cmd": [
            "@publish-assets"
        ],
        "post-update-cmd": [
            "@publish-assets"
        ],
        "publish-assets": [
            "mkdir -p public/vendor/bootstrap",
            "cp -R vendor/twbs/bootstrap/dist/. public/vendor/bootstrap/",
            "mkdir -p public/vendor/bootstrap-icons",
            "cp -R vendor/twbs/bootstrap-icons/font/. public/vendor/bootstrap-icons/"
        ],
        "console": "php bin/console.php",
        "phpstan": "vendor/bin/phpstan analyze --memory-limit=512M"
    }
}
