{% extends '@frontend/layouts/base.twig' %}

{% block title %}500 · {{ config('app.name') }}{% endblock %}
{% block body_class %}page-404{% endblock %}

{% block page_title %}
  {% include '@frontend/partials/page-title.twig' with {
    page_heading: '500',
    breadcrumbs: [
      { label: 'Home', url: uri('home') },
      { label: '500', current: true },
    ],
  } %}
{% endblock %}

{% block content %}
<section id="error-500" class="error-404 section">
  <div class="container" data-aos="fade-up" data-aos-delay="100">
    <div class="text-center">
      <div class="error-icon mb-4">
        <i class="bi bi-exclamation-triangle"></i>
      </div>
      <h1 class="error-code mb-4">500</h1>
      <h2 class="error-title mb-3">Something went wrong</h2>
      <p class="error-text mb-4">Please try again later.</p>
      <div class="error-action">
        <a href="{{ uri('home') }}" class="btn btn-primary">Back to Home</a>
      </div>
    </div>
  </div>
</section>
{% endblock %}
