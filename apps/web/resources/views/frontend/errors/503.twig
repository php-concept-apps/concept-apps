{% extends '@frontend/layouts/base.twig' %}

{% block title %}503 · {{ config('app.name') }}{% endblock %}
{% block body_class %}page-404{% endblock %}

{% block page_title %}
  {% include '@frontend/partials/page-title.twig' with {
    page_heading: '503',
    breadcrumbs: [
      { label: 'Home', url: uri('home') },
      { label: '503', current: true },
    ],
  } %}
{% endblock %}

{% block content %}
<section id="error-503" class="error-404 section">
  <div class="container" data-aos="fade-up">
    <div class="text-center">
      <h1 class="error-code mb-4">503</h1>
      <h2 class="error-title mb-3">Service unavailable</h2>
      <p class="error-text mb-4">Please try again in a moment.</p>
      <div class="error-action">
        <a href="{{ uri('home') }}" class="btn btn-primary">Back to Home</a>
      </div>
    </div>
  </div>
</section>
{% endblock %}
