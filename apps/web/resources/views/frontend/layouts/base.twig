<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}{{ config('app.name') }}{% endblock %}</title>
    <style>
        :root {
            --bg: #f7f5f1;
            --ink: #1c1917;
            --muted: #78716c;
            --line: #e7e5e4;
            --accent: #0f766e;
        }
        * { box-sizing: border-box; }
        body {
            margin: 0;
            font-family: "Iowan Old Style", "Palatino Linotype", Palatino, Georgia, serif;
            background: var(--bg);
            color: var(--ink);
            line-height: 1.55;
        }
        .shell { max-width: 42rem; margin: 0 auto; padding: 2.5rem 1.25rem 4rem; }
        header { margin-bottom: 2.5rem; padding-bottom: 1rem; border-bottom: 1px solid var(--line); }
        .brand {
            font-size: 0.85rem;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: var(--accent);
            text-decoration: none;
            font-weight: 700;
        }
        h1 { font-size: 2rem; margin: 0 0 0.75rem; line-height: 1.2; }
        p { margin: 0 0 1rem; color: var(--muted); }
        .meta { font-size: 0.95rem; color: var(--muted); }
        .flash { list-style: none; padding: 0; margin: 0 0 1.5rem; }
        .flash li {
            padding: 0.75rem 1rem;
            border: 1px solid var(--line);
            background: #fff;
            margin-bottom: 0.5rem;
        }
    </style>
</head>
<body>
<div class="shell">
    <header>
        <a class="brand" href="{{ uri('home') }}">{{ config('app.name') }}</a>
    </header>

    {% if flashes is defined and flashes %}
        <ul class="flash">
            {% for flash in flashes %}
                <li>{{ flash.message|default(flash) }}</li>
            {% endfor %}
        </ul>
    {% endif %}

    {% block content %}{% endblock %}
</div>
</body>
</html>
