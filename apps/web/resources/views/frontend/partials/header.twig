<header id="header" class="header d-flex align-items-center {{ header_class|default('sticky-top') }}">
  <div class="container-fluid container-xl position-relative d-flex align-items-center">

    <a href="{{ uri('home') }}" class="logo d-flex align-items-center me-auto">
      <h1 class="sitename">{{ config('app.name') }}</h1>
    </a>

    <nav id="navmenu" class="navmenu">
      <ul>
        <li><a href="{{ uri('home') }}" class="{% if app_nav|default('home') == 'home' %}active{% endif %}">Home</a></li>
        <li><a href="{{ uri('home') }}" class="{% if app_nav|default('') == 'blog' %}active{% endif %}">Blog</a></li>
      </ul>
      <i class="mobile-nav-toggle d-xl-none bi bi-list"></i>
    </nav>

    <a class="btn-getstarted" href="{{ uri('home') }}">Get Started</a>

  </div>
</header>
