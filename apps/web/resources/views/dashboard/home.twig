{% extends '@dashboard/layouts/base.twig' %}

{% block title %}Dashboard · {{ config('app.name') }}{% endblock %}

{% block content_header %}
  {% include '@dashboard/partials/content-header.twig' with {
    page_heading: 'Dashboard',
    breadcrumbs: [
      { label: 'Home', url: uri('admin.home') },
      { label: 'Dashboard', current: true },
    ],
  } %}
{% endblock %}

{% block content %}
<div class="row">
  <div class="col-md-4">
    <div class="small-box text-bg-primary">
      <div class="inner">
        <h3>{{ posts_count }}</h3>
        <p>Posts</p>
      </div>
      <a href="{{ uri('admin.posts') }}" class="small-box-footer link-light link-underline-opacity-0">
        Manage <i class="bi bi-link-45deg"></i>
      </a>
    </div>
  </div>
  <div class="col-md-4">
    <div class="small-box text-bg-success">
      <div class="inner">
        <h3>{{ categories_count }}</h3>
        <p>Categories</p>
      </div>
      <a href="{{ uri('admin.categories') }}" class="small-box-footer link-light link-underline-opacity-0">
        Manage <i class="bi bi-link-45deg"></i>
      </a>
    </div>
  </div>
  <div class="col-md-4">
    <div class="small-box text-bg-warning">
      <div class="inner">
        <h3>{{ tags_count }}</h3>
        <p>Tags</p>
      </div>
      <a href="{{ uri('admin.tags') }}" class="small-box-footer link-light link-underline-opacity-0">
        Manage <i class="bi bi-link-45deg"></i>
      </a>
    </div>
  </div>
</div>
{% endblock %}
