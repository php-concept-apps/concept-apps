{% extends '@dashboard/layouts/error.twig' %}

{% block title %}404 · {{ config('app.name') }}{% endblock %}

{% block body %}
  <p class="display-1 fw-bold mb-2">404</p>
  <p class="login-box-msg mb-3">Page not found</p>
  <p class="text-body-secondary mb-4">
    The admin page you requested does not exist or may have been moved.
  </p>
  <div class="d-grid gap-2">
    <a href="{{ uri('admin.home') }}" class="btn btn-primary">Back to dashboard</a>
    <a href="javascript:history.back()" class="btn btn-outline-secondary">Go back</a>
  </div>
{% endblock %}
