{% extends '@dashboard/layouts/base.twig' %}

{% block title %}Categories · {{ config('app.name') }}{% endblock %}

{% block content_header %}
  {% include '@dashboard/partials/content-header.twig' with {
    page_heading: 'Categories',
    breadcrumbs: [
      { label: 'Home', url: uri('admin.home') },
      { label: 'Categories', current: true },
    ],
  } %}
{% endblock %}

{% block content %}
<form id="categories-filter" method="get" action="{{ uri('admin.categories') }}" class="d-none">
  <input type="hidden" name="sort" value="{{ sort_column }}">
  <input type="hidden" name="dir" value="{{ sort_dir }}">
</form>

<div class="card">
  <div class="card-header">
    <div class="card-tools">
      <a class="btn btn-primary btn-sm" href="{{ uri('admin.categories.create') }}">
        <i class="bi bi-plus-lg me-1"></i> New category
      </a>
    </div>
  </div>
  <div class="card-body table-responsive p-0">
    <table class="table table-striped table-hover mb-0 align-middle">
      <thead>
        <tr>
          {% include '@dashboard/partials/_sortable_th.twig' with { column: 'id', label: 'ID', sort_column: sort_column, sort_dir: sort_dir, filter_query: filter_query, route: 'admin.categories' } %}
          {% include '@dashboard/partials/_sortable_th.twig' with { column: 'name', label: 'Name', sort_column: sort_column, sort_dir: sort_dir, filter_query: filter_query, route: 'admin.categories' } %}
          {% include '@dashboard/partials/_sortable_th.twig' with { column: 'slug', label: 'Slug', sort_column: sort_column, sort_dir: sort_dir, filter_query: filter_query, route: 'admin.categories' } %}
          {% include '@dashboard/partials/_sortable_th.twig' with { column: 'sort_order', label: 'Sort', sort_column: sort_column, sort_dir: sort_dir, filter_query: filter_query, route: 'admin.categories' } %}
          {% include '@dashboard/partials/_sortable_th.twig' with { column: 'updated_at', label: 'Updated', sort_column: sort_column, sort_dir: sort_dir, filter_query: filter_query, route: 'admin.categories' } %}
          <th class="text-end">Actions</th>
        </tr>
        <tr class="table-filters">
          <th></th>
          <th>
            <input
              form="categories-filter"
              id="filter_name"
              type="search"
              name="name"
              class="form-control form-control-sm"
              value="{{ filter.name|default('') }}"
              placeholder="Filter…"
              aria-label="Filter by name"
            >
          </th>
          <th>
            <input
              form="categories-filter"
              id="filter_slug"
              type="search"
              name="slug"
              class="form-control form-control-sm"
              value="{{ filter.slug|default('') }}"
              placeholder="Filter…"
              aria-label="Filter by slug"
            >
          </th>
          <th>
            <input
              form="categories-filter"
              id="filter_sort_order"
              type="number"
              name="sort_order"
              class="form-control form-control-sm"
              value="{{ filter.sortOrder is not null ? filter.sortOrder : '' }}"
              placeholder="Filter…"
              aria-label="Filter by sort order"
              onchange="this.form.requestSubmit()"
            >
          </th>
          <th>
            <input
              form="categories-filter"
              id="filter_updated_at"
              type="date"
              name="updated_at"
              class="form-control form-control-sm"
              value="{{ filter.updatedAt|default('') }}"
              aria-label="Filter by updated date"
              onchange="this.form.requestSubmit()"
            >
          </th>
          <th class="text-end text-nowrap">
            <button
              form="categories-filter"
              type="submit"
              class="btn btn-outline-secondary btn-sm"
              title="Apply filters"
              aria-label="Apply filters"
            >
              <i class="bi bi-funnel" aria-hidden="true"></i>
            </button>
            {% if filter.isActive %}
              <a
                href="{{ uri('admin.categories') }}?sort={{ sort_column }}&dir={{ sort_dir }}"
                class="btn btn-outline-secondary btn-sm"
                title="Reset filters"
                aria-label="Reset filters"
              >
                <i class="bi bi-x-lg" aria-hidden="true"></i>
              </a>
            {% endif %}
          </th>
        </tr>
      </thead>
      <tbody>
        {% for category in categories %}
          <tr>
            <td class="text-muted">#{{ category.id }}</td>
            <td><a href="{{ uri('admin.categories.edit', {id: category.id}) }}">{{ category.name }}</a></td>
            <td>{{ category.slug }}</td>
            <td>{{ category.sort_order }}</td>
            <td class="text-nowrap">{{ category.updated_at ? category.updated_at|date('Y-m-d H:i') : '—' }}</td>
            <td class="text-end text-nowrap">
              <form action="{{ uri('admin.categories.destroy', {id: category.id}) }}" method="post" class="d-inline" onsubmit="return confirm('Delete this category?')">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token }}">
                <button type="submit" class="btn btn-outline-danger btn-sm" title="Delete" aria-label="Delete">
                  <i class="bi bi-trash"></i>
                </button>
              </form>
              <a
                class="btn btn-outline-secondary btn-sm"
                href="{{ uri('admin.categories.edit', {id: category.id}) }}"
                title="Edit"
                aria-label="Edit"
              >
                <i class="bi bi-pencil"></i>
              </a>
            </td>
          </tr>
        {% else %}
          <tr>
            <td colspan="6" class="text-center text-muted py-4">
              {{ filter.isActive ? 'No categories match the current filters.' : 'No categories yet.' }}
            </td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% if categories.total > 0 %}
    <div class="card-footer clearfix">
      <span class="float-start text-muted">
        Showing <strong>{{ categories.firstItem }}–{{ categories.lastItem }}</strong> of {{ categories.total }}
      </span>
      {% include '@dashboard/partials/_pagination.twig' with { items: categories } %}
    </div>
  {% endif %}
</div>
{% endblock %}
