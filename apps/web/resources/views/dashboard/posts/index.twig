{% extends '@dashboard/layouts/base.twig' %}

{% block title %}Posts · {{ config('app.name') }}{% endblock %}

{% block content_header %}
  {% include '@dashboard/partials/content-header.twig' with {
    page_heading: 'Posts',
    breadcrumbs: [
      { label: 'Home', url: uri('admin.home') },
      { label: 'Posts', current: true },
    ],
  } %}
{% endblock %}

{% block content %}
<form id="posts-filter" method="get" action="{{ uri('admin.posts') }}" class="d-none">
  <input type="hidden" name="sort" value="{{ sort_column }}">
  <input type="hidden" name="dir" value="{{ sort_dir }}">
</form>

<div class="card">
  <div class="card-header">
    <div class="card-tools">
      <a class="btn btn-primary btn-sm" href="{{ uri('admin.posts.create') }}">
        <i class="bi bi-plus-lg me-1"></i> New post
      </a>
    </div>
  </div>
  <div class="card-body table-responsive p-0">
    <table class="table table-striped table-hover mb-0 align-middle">
      <thead>
        <tr>
          {% include '@dashboard/partials/_sortable_th.twig' with { column: 'id', label: 'ID', sort_column: sort_column, sort_dir: sort_dir, filter_query: filter_query } %}
          {% include '@dashboard/partials/_sortable_th.twig' with { column: 'title', label: 'Title', sort_column: sort_column, sort_dir: sort_dir, filter_query: filter_query } %}
          {% include '@dashboard/partials/_sortable_th.twig' with { column: 'category', label: 'Category', sort_column: sort_column, sort_dir: sort_dir, filter_query: filter_query } %}
          <th>Tags</th>
          {% include '@dashboard/partials/_sortable_th.twig' with { column: 'status', label: 'Status', sort_column: sort_column, sort_dir: sort_dir, filter_query: filter_query } %}
          {% include '@dashboard/partials/_sortable_th.twig' with { column: 'published_at', label: 'Published', sort_column: sort_column, sort_dir: sort_dir, filter_query: filter_query } %}
          {% include '@dashboard/partials/_sortable_th.twig' with { column: 'updated_at', label: 'Updated', sort_column: sort_column, sort_dir: sort_dir, filter_query: filter_query } %}
          <th class="text-end">Actions</th>
        </tr>
        <tr class="table-filters">
          <th></th>
          <th>
            <input
              form="posts-filter"
              id="filter_q"
              type="search"
              name="q"
              class="form-control form-control-sm"
              value="{{ filter.search|default('') }}"
              placeholder="Filter…"
              aria-label="Filter by title or slug"
            >
          </th>
          <th>
            <select
              form="posts-filter"
              id="filter_category_id"
              name="category_id"
              class="form-select form-select-sm"
              aria-label="Filter by category"
              onchange="this.form.requestSubmit()"
            >
              <option value=""></option>
              {% for category in categories %}
                <option value="{{ category.id }}" {{ filter.categoryId == category.id ? 'selected' : '' }}>
                  {{ category.name }}
                </option>
              {% endfor %}
            </select>
          </th>
          <th>
            <select
              form="posts-filter"
              id="filter_tag_id"
              name="tag_id"
              class="form-select form-select-sm"
              aria-label="Filter by tag"
              onchange="this.form.requestSubmit()"
            >
              <option value=""></option>
              {% for tag in tags %}
                <option value="{{ tag.id }}" {{ filter.tagId == tag.id ? 'selected' : '' }}>
                  {{ tag.name }}
                </option>
              {% endfor %}
            </select>
          </th>
          <th>
            <select
              form="posts-filter"
              id="filter_status"
              name="status"
              class="form-select form-select-sm"
              aria-label="Filter by status"
              onchange="this.form.requestSubmit()"
            >
              <option value=""></option>
              {% for status in statuses %}
                <option value="{{ status.value }}" {{ filter.status and filter.status.value == status.value ? 'selected' : '' }}>
                  {{ status.value }}
                </option>
              {% endfor %}
            </select>
          </th>
          <th>
            <input
              form="posts-filter"
              id="filter_published_at"
              type="date"
              name="published_at"
              class="form-control form-control-sm"
              value="{{ filter.publishedAt|default('') }}"
              aria-label="Filter by published date"
              onchange="this.form.requestSubmit()"
            >
          </th>
          <th>
            <input
              form="posts-filter"
              id="filter_updated_at"
              type="date"
              name="updated_at"
              class="form-control form-control-sm"
              value="{{ filter.updatedAt|default('') }}"
              aria-label="Filter by updated date"
              onchange="this.form.requestSubmit()"
            >
          </th>
          <th class="text-end text-nowrap">
            <button
              form="posts-filter"
              type="submit"
              class="btn btn-outline-secondary btn-sm"
              title="Apply filters"
              aria-label="Apply filters"
            >
              <i class="bi bi-funnel" aria-hidden="true"></i>
            </button>
            {% if filter.isActive %}
              <a
                href="{{ uri('admin.posts') }}?sort={{ sort_column }}&dir={{ sort_dir }}"
                class="btn btn-outline-secondary btn-sm"
                title="Reset filters"
                aria-label="Reset filters"
              >
                <i class="bi bi-x-lg" aria-hidden="true"></i>
              </a>
            {% endif %}
          </th>
        </tr>
      </thead>
      <tbody>
        {% for post in posts %}
          <tr>
            <td class="text-muted">#{{ post.id }}</td>
            <td>
              <a href="{{ uri('admin.posts.edit', {id: post.id}) }}">{{ post.title }}</a>
              <div class="small text-muted">{{ post.slug }}</div>
            </td>
            <td>{{ post.category ? post.category.name : '—' }}</td>
            <td>
              {% if post.tags is not empty %}
                <div class="d-flex flex-wrap gap-1">
                  {% for tag in post.tags %}
                    <span class="badge text-bg-light border fw-normal">{{ tag.name }}</span>
                  {% endfor %}
                </div>
              {% else %}
                <span class="text-muted">—</span>
              {% endif %}
            </td>
            <td>
              {% set badge = post.status.value == 'published' ? 'success' : (post.status.value == 'archived' ? 'secondary' : 'warning') %}
              <span class="badge text-bg-{{ badge }}">{{ post.status.value }}</span>
            </td>
            <td class="text-nowrap">{{ post.published_at ? post.published_at|date('Y-m-d H:i') : '—' }}</td>
            <td class="text-nowrap">{{ post.updated_at ? post.updated_at|date('Y-m-d H:i') : '—' }}</td>
            <td class="text-end text-nowrap">
              <form action="{{ uri('admin.posts.destroy', {id: post.id}) }}" method="post" class="d-inline" onsubmit="return confirm('Delete this post?')">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token }}">
                <button type="submit" class="btn btn-outline-danger btn-sm" title="Delete" aria-label="Delete">
                  <i class="bi bi-trash"></i>
                </button>
              </form>
              <a
                class="btn btn-outline-secondary btn-sm"
                href="{{ uri('admin.posts.edit', {id: post.id}) }}"
                title="Edit"
                aria-label="Edit"
              >
                <i class="bi bi-pencil"></i>
              </a>
            </td>
          </tr>
        {% else %}
          <tr>
            <td colspan="8" class="text-center text-muted py-4">
              {{ filter.isActive ? 'No posts match the current filters.' : 'No posts yet.' }}
            </td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% if posts.total > 0 %}
    <div class="card-footer clearfix">
      <span class="float-start text-muted">
        Showing <strong>{{ posts.firstItem }}–{{ posts.lastItem }}</strong> of {{ posts.total }}
      </span>
      {% include '@dashboard/partials/_pagination.twig' with { items: posts } %}
    </div>
  {% endif %}
</div>
{% endblock %}
