{
    "name": "php-concept/app-cli",
    "description": "Concept 2 — CLI assembly (console + database, no HTTP/session/view)",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "php-concept/brick-console-symfony": "^1.0",
        "php-concept/brick-database-eloquent": "^1.0",
        "php-concept/brick-error-handler-whoops": "^1.0",
        "php-concept/brick-logger-monolog": "^1.0",
        "php-concept/core-2": "^1.0",
        "php-concept/extension-config": "^1.0",
        "php-concept/extension-path-manager": "^1.0",
        "php-concept/stack": "^2.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "Concept\\": "src/",
            "Concept\\Components\\": "../../components/"
        }
    },
    "scripts": {
        "console": "php bin/console.php",
        "phpstan": "vendor/bin/phpstan analyze --memory-limit=512M"
    },
    "config": {
        "sort-packages": true
    }
}
